{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "repo_path"
  ],
  "properties": {
    "target": {
      "const": "local"
    },
    "repo_path": {
      "type": "string",
      "minLength": 1
    },
    "endpoint_base_url": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
